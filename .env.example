# ── Database ────────────────────────────────────────────────────────────────
# Supabase gives 2 direct connections; with 2+ services the pooler (:6543) is
# mandatory, otherwise connections hang after a Railway rolling deploy.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# ── Solana ──────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_CLUSTER=devnet
# Kept in sync with declare_id! and both Anchor.toml clusters by
# tests/config-consistency.test.ts. The keypair behind it lives in
# target/deploy/, which is gitignored — wipe target and `anchor keys sync`
# mints a different address, so back that file up before the first deploy.
PROGRAM_ID=DsRdHv4QRYQ7teVhwuLVttktF792gvDFQdiuraQ4eF4P

# ── Attestor worker ─────────────────────────────────────────────────────────
# Base58 secret key. Never a file path inside the repo — *.keypair.json and
# id.json are blocked by the pre-commit guard for a reason.
ATTESTOR_KEYPAIR=
# Seconds between polls while the WebSocket is down. 60s keeps 15 watched
# addresses inside the 1M/mo Helius budget (docs/PLAN.md → Free tier capacity).
ATTESTOR_FALLBACK_POLL_SECONDS=60
# Seconds between signature sweeps while the WebSocket looks healthy. No provider
# guarantees delivery of every notification, and a dropped one leaves no trace —
# this bounds how long such a transaction can stay unseen. ~6.5% of the Helius
# budget at 15 addresses.
ATTESTOR_RECONCILE_SECONDS=600
# How far back the first sweep after a restart reaches. A restart is an outage
# like any other; this is the window it covers.
ATTESTOR_STARTUP_LOOKBACK_SECONDS=900

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3000
API_RATE_LIMIT_PER_MIN=60

# ── Web (Vite, public — never put a secret behind VITE_) ─────────────────────
VITE_API_URL=http://localhost:3000
